  "tag_structure_patterns": {
    "_description": "Common patterns for how industrial tags are structured. These help parse and generate human-readable descriptions.",

    "isa_standard_pattern": {
      "format": "<InstrumentLetters><LoopNumber>",
      "example": "FIC-045",
      "parsed": "Flow (F) Indicating (I) Controller (C), Loop 045",
      "regex_hint": "^([A-Z]{2,5})-?(\\d{2,5})$"
    },

    "area_prefixed_pattern": {
      "format": "<AreaCode>-<InstrumentLetters>-<LoopNumber>",
      "example": "600-TIC-001",
      "parsed": "Area 600 (Kiln), Temperature (T) Indicating (I) Controller (C), Loop 001"
    },

    "equipment_tagged_pattern": {
      "format": "<EquipmentCode><Number>_<InstrumentLetters><LoopNumber>",
      "example": "FN301_TI_001",
      "parsed": "Fan 301, Temperature Indicator 001"
    },

    "dcs_point_pattern": {
      "format": "<Tag>.<Suffix>",
      "examples": {
        "FIC045.PV": "Flow Indicating Controller 045, Process Variable (actual flow reading)",
        "FIC045.SP": "Flow Indicating Controller 045, Setpoint (target flow value)",
        "FIC045.MV": "Flow Indicating Controller 045, Manipulated Variable (valve output %)",
        "FIC045.AUTO": "Flow Indicating Controller 045, Auto/Manual mode status",
        "TT100.PV": "Temperature Transmitter 100, Process Variable (actual temperature)",
        "LIC200.OP": "Level Indicating Controller 200, Output percentage"
      }
    },

    "cement_common_patterns": [
      {
        "example": "811FN01",
        "interpretation": "Area 8 (Cement Mill), Unit 11, Fan 01",
        "pattern": "<Area><Unit><EquipmentType><SeqNumber>"
      },
      {
        "example": "531TI001",
        "interpretation": "Area 5 (Preheater), Unit 31, Temperature Indicator 001",
        "pattern": "<Area><Unit><InstrumentCode><SeqNumber>"
      },
      {
        "example": "KN1_TI_BZ_01",
        "interpretation": "Kiln 1, Temperature Indicator, Burning Zone, Sensor 01",
        "pattern": "<Equipment><Number>_<InstrumentCode>_<Location>_<SeqNumber>"
      }
    ],

    "oil_gas_common_patterns": [
      {
        "example": "20-PT-001",
        "interpretation": "Area 20 (Separation), Pressure Transmitter 001",
        "pattern": "<AreaCode>-<InstrumentCode>-<SeqNumber>"
      },
      {
        "example": "30-FIC-002A",
        "interpretation": "Area 30 (Compression), Flow Indicating Controller 002, redundant A",
        "pattern": "<AreaCode>-<InstrumentCode>-<SeqNumber><Suffix>"
      },
      {
        "example": "V-2001",
        "interpretation": "Vessel 2001 (Area 20, equipment 01)",
        "pattern": "<EquipmentType>-<AreaEquipmentNumber>"
      }
    ]
  },

