  "signal_variable_suffixes": {
    "_description": "DCS/SCADA/PLC tag suffixes appended to instrument tags to identify the type of signal or variable. These are critical for interpreting control loop data.",

    "control_loop_variables": {
      "PV": { "name": "Process Variable", "description": "The actual measured value from the field sensor/transmitter. This is what the process IS doing. Example: actual temperature reading." },
      "SP": { "name": "Setpoint", "description": "The desired target value that the controller is trying to maintain. This is what you WANT the process to do." },
      "SV": { "name": "Setpoint Variable", "description": "Alternative notation for Setpoint (same as SP). Common in some DCS systems." },
      "MV": { "name": "Manipulated Variable", "description": "The controller output signal sent to the final control element (valve, damper, VFD). This is what the controller DOES to control the process. Usually expressed as 0-100%." },
      "CV": { "name": "Control Variable / Controller Output", "description": "Alternative notation for Manipulated Variable (same as MV). The output of the controller." },
      "OP": { "name": "Output", "description": "Controller output percentage (0-100%). Same concept as MV/CV, commonly used in some DCS platforms." },
      "OUT": { "name": "Output", "description": "Alternative notation for controller output." },
      "ERR": { "name": "Error", "description": "Difference between SP and PV (Error = SP - PV)." },
      "DEV": { "name": "Deviation", "description": "Same as Error. The deviation of PV from SP." }
    },

    "controller_mode": {
      "AUTO": { "name": "Automatic Mode", "description": "Controller is automatically adjusting MV based on PV-SP error." },
      "MAN": { "name": "Manual Mode", "description": "Operator manually sets the MV/output; controller computation is bypassed." },
      "CAS": { "name": "Cascade Mode", "description": "Setpoint is received from an upstream (master) controller rather than being set manually." },
      "REM": { "name": "Remote Mode", "description": "Setpoint or output is set remotely by another system (e.g., advanced process control)." },
      "RSP": { "name": "Remote Setpoint", "description": "Setpoint provided by a remote/advanced controller." },
      "LCL": { "name": "Local Mode", "description": "Controller accepts local (field) commands rather than DCS commands." },
      "TRK": { "name": "Tracking Mode", "description": "Controller output tracks an external signal." }
    },

    "tuning_parameters": {
      "KP": { "name": "Proportional Gain (Kp)", "description": "Proportional gain constant of PID controller." },
      "KI": { "name": "Integral Gain (Ki)", "description": "Integral gain constant of PID controller." },
      "KD": { "name": "Derivative Gain (Kd)", "description": "Derivative gain constant of PID controller." },
      "TI": { "name": "Integral Time (Ti)", "description": "Integral time constant (minutes/repeats). Ti = Kp / Ki." },
      "TD": { "name": "Derivative Time (Td)", "description": "Derivative time constant (minutes). Td = Kd / Kp." },
      "PB": { "name": "Proportional Band", "description": "Proportional band percentage. PB = 100 / Kp." },
      "DB": { "name": "Dead Band", "description": "Dead band / hysteresis around setpoint." },
      "BIAS": { "name": "Bias / Manual Reset", "description": "Output bias value added to controller output." }
    },

    "alarm_suffixes": {
      "ALM": { "name": "Alarm", "description": "Generic alarm state" },
      "HI": { "name": "High Alarm", "description": "Value has exceeded high alarm limit" },
      "HIHI": { "name": "High-High Alarm", "description": "Value has exceeded critical high alarm limit (trip level)" },
      "LO": { "name": "Low Alarm", "description": "Value has dropped below low alarm limit" },
      "LOLO": { "name": "Low-Low Alarm", "description": "Value has dropped below critical low alarm limit (trip level)" },
      "H": { "name": "High", "description": "High limit value" },
      "HH": { "name": "High-High", "description": "High-high critical limit value" },
      "L": { "name": "Low", "description": "Low limit value" },
      "LL": { "name": "Low-Low", "description": "Low-low critical limit value" }
    },

    "status_suffixes": {
      "STS": { "name": "Status", "description": "General status of instrument or device" },
      "RUN": { "name": "Running", "description": "Equipment is running/operating" },
      "STOP": { "name": "Stopped", "description": "Equipment is stopped" },
      "TRIP": { "name": "Tripped", "description": "Equipment has tripped (emergency stop)" },
      "FLT": { "name": "Fault", "description": "Equipment fault/failure detected" },
      "FAIL": { "name": "Failure", "description": "Instrument or device failure" },
      "RDY": { "name": "Ready", "description": "Equipment is ready to start" },
      "FB": { "name": "Feedback", "description": "Position or status feedback signal" },
      "CMD": { "name": "Command", "description": "Command signal sent to device" },
      "ENB": { "name": "Enable", "description": "Enable/disable signal" },
      "OPN": { "name": "Open", "description": "Valve or damper open status" },
      "CLS": { "name": "Closed", "description": "Valve or damper closed status" },
      "OPNG": { "name": "Opening", "description": "Valve or damper is opening (transitioning)" },
      "CLSG": { "name": "Closing", "description": "Valve or damper is closing (transitioning)" }
    },

    "engineering_units_common": {
      "EU": { "name": "Engineering Units", "description": "Scaled value in physical engineering units" },
      "RAW": { "name": "Raw Value", "description": "Unscaled raw analog input value" },
      "PCT": { "name": "Percent (%)", "description": "Value expressed as percentage" },
      "RATE": { "name": "Rate", "description": "Rate of change of the measured variable" }
    }
  },

