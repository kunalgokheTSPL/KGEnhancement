{
  "_metadata": {
    "title": "Industrial Tag Naming Convention Reference",
    "description": "Comprehensive mapping of instrument tag codes to human-readable descriptions. Based on ISA 5.1 (ANSI/ISA-5.1-2009), ISO 14617-6, and industry-specific conventions for cement and oil & gas industries. Used by CDM pipeline to generate human-readable tag descriptions for frontend display.",
    "version": "1.0.0",
    "standards_referenced": [
      "ANSI/ISA-5.1-2009 (Instrumentation Symbols and Identification)",
      "ISO 14617-6 (Graphical symbols for diagrams - Measurement and control functions)",
      "IEC 62424 (Representation of process control engineering)",
      "API RP 14C (Analysis, Design, Installation of Basic Surface Safety Systems)",
      "API RP 551 (Process Measurement Instrumentation)"
    ],
    "industries": ["cement", "oil_and_gas", "petrochemical", "general_process"],
    "last_updated": "2026-04-08"
  },

  "isa_5_1": {
    "_description": "ISA 5.1 standard letter codes used in P&ID instrument tag identification. Tags follow the format: [First Letter(s)][Succeeding Letters][Loop Number], e.g., FIC-045 = Flow Indicating Controller, loop 045.",

    "first_letter": {
      "_description": "First letter identifies the measured or initiating variable.",
      "A": { "variable": "Analysis", "description": "Composition or property analysis (e.g., pH, O2, CO, conductivity, chromatography)" },
      "B": { "variable": "Burner / Combustion", "description": "Burner or combustion-related measurement" },
      "C": { "variable": "User Choice", "description": "Commonly used for Conductivity in many plants" },
      "D": { "variable": "User Choice", "description": "Commonly used for Density or Differential" },
      "E": { "variable": "Voltage", "description": "Electrical voltage measurement" },
      "F": { "variable": "Flow Rate", "description": "Volumetric or mass flow rate" },
      "G": { "variable": "User Choice", "description": "Commonly used for Gauging or Gas detection" },
      "H": { "variable": "Hand", "description": "Manual or hand-operated" },
      "I": { "variable": "Current (Electrical)", "description": "Electrical current measurement" },
      "J": { "variable": "Power", "description": "Electrical power measurement" },
      "K": { "variable": "Time / Time Schedule", "description": "Time-related measurement or scheduling" },
      "L": { "variable": "Level", "description": "Liquid or solid level measurement" },
      "M": { "variable": "User Choice", "description": "Commonly used for Moisture in cement industry" },
      "N": { "variable": "User Choice", "description": "Commonly used for Torque" },
      "O": { "variable": "User Choice", "description": "User-defined variable" },
      "P": { "variable": "Pressure / Vacuum", "description": "Pressure or vacuum measurement" },
      "Q": { "variable": "Quantity", "description": "Quantity or event count" },
      "R": { "variable": "Radiation", "description": "Radiation measurement (also used for nuclear level gauges)" },
      "S": { "variable": "Speed / Frequency", "description": "Rotational speed or frequency measurement" },
      "T": { "variable": "Temperature", "description": "Temperature measurement" },
      "U": { "variable": "Multivariable", "description": "Multiple measured variables combined" },
      "V": { "variable": "Vibration / Mechanical Analysis", "description": "Vibration or mechanical analysis measurement" },
      "W": { "variable": "Weight / Force", "description": "Weight or force measurement" },
      "X": { "variable": "Unclassified", "description": "Unclassified variable; commonly used for on-off valve (XV)" },
      "Y": { "variable": "Event / State / Presence", "description": "Event, binary state, or presence detection" },
      "Z": { "variable": "Position / Dimension", "description": "Position or dimensional measurement" }
    },

    "modifier_letter": {
      "_description": "Modifier letter (optional, appears after first letter to modify its meaning).",
      "D": { "modifier": "Differential", "description": "Differential measurement (e.g., PD = Differential Pressure)" },
      "F": { "modifier": "Ratio / Fraction", "description": "Ratio or fraction of a measurement (e.g., FF = Flow Ratio)" },
      "J": { "modifier": "Scan", "description": "Scanning function" },
      "K": { "modifier": "Time Rate of Change", "description": "Rate of change over time" },
      "M": { "modifier": "Momentary", "description": "Momentary or temporary" },
      "Q": { "modifier": "Integrate / Totalize", "description": "Integrated or totalized value (e.g., FQ = Flow Totalizer)" },
      "S": { "modifier": "Safety", "description": "Safety-instrumented function (e.g., PS = Pressure Safety)" },
      "X": { "modifier": "X-Axis", "description": "X-axis measurement" },
      "Y": { "modifier": "Y-Axis", "description": "Y-axis measurement" },
      "Z": { "modifier": "Z-Axis", "description": "Z-axis measurement" }
    },

    "readout_passive_function": {
      "_description": "Succeeding letter(s) indicating readout or passive function.",
      "A": { "function": "Alarm", "description": "Alarm notification function" },
      "B": { "function": "User Choice", "description": "User-defined readout function" },
      "E": { "function": "Sensor / Primary Element", "description": "Sensing element (e.g., TE = Temperature Element/Sensor)" },
      "G": { "function": "Glass / Viewing Device", "description": "Sight glass or gauge glass" },
      "I": { "function": "Indicate", "description": "Indicator or indication function" },
      "L": { "function": "Light / Pilot", "description": "Pilot light or indicator light" },
      "N": { "function": "User Choice", "description": "User-defined passive function" },
      "O": { "function": "Orifice / Restriction", "description": "Orifice plate or flow restriction" },
      "P": { "function": "Point / Test Connection", "description": "Test point or connection" },
      "R": { "function": "Record", "description": "Recording function (chart recorder, data logger)" },
      "U": { "function": "Multifunction", "description": "Multiple passive functions combined" },
      "W": { "function": "Well / Probe", "description": "Thermowell or instrument probe" },
      "X": { "function": "Unclassified", "description": "Unclassified passive function" }
    },

    "output_active_function": {
      "_description": "Succeeding letter(s) indicating output or active/control function.",
      "B": { "function": "User Choice", "description": "User-defined output function" },
      "C": { "function": "Control", "description": "Automatic control function (e.g., TIC = Temperature Indicating Controller)" },
      "K": { "function": "Control Station", "description": "Control station or manual loading station" },
      "N": { "function": "User Choice", "description": "User-defined output function" },
      "S": { "function": "Switch", "description": "Switching function (on/off, high/low)" },
      "T": { "function": "Transmit", "description": "Transmitter function (e.g., TT = Temperature Transmitter)" },
      "U": { "function": "Multifunction", "description": "Multiple output functions combined" },
      "V": { "function": "Valve / Damper / Louver", "description": "Final control element: valve, damper, or louver" },
      "X": { "function": "Unclassified", "description": "Unclassified output function" },
      "Y": { "function": "Relay / Compute / Convert", "description": "Relay, computation, or signal conversion function" },
      "Z": { "function": "Driver / Actuator", "description": "Actuator or driver for final control element" }
    },

    "function_modifier": {
      "_description": "Final letter modifier indicating alarm level or operating point.",
      "B": { "modifier": "User Choice", "description": "User-defined modifier" },
      "C": { "modifier": "Close", "description": "Close position or closed state" },
      "D": { "modifier": "Deviation", "description": "Deviation from setpoint" },
      "H": { "modifier": "High", "description": "High-level alarm or setpoint (e.g., TAH = Temperature Alarm High)" },
      "HH": { "modifier": "High-High", "description": "High-high critical alarm (e.g., TAHH = Temperature Alarm High-High)" },
      "L": { "modifier": "Low", "description": "Low-level alarm or setpoint (e.g., PAL = Pressure Alarm Low)" },
      "LL": { "modifier": "Low-Low", "description": "Low-low critical alarm (e.g., PALL = Pressure Alarm Low-Low)" },
      "M": { "modifier": "Middle / Intermediate", "description": "Middle or intermediate value" },
      "N": { "modifier": "User Choice", "description": "User-defined modifier" },
      "O": { "modifier": "Open", "description": "Open position or opened state" },
      "R": { "modifier": "Run", "description": "Running state" },
      "S": { "modifier": "Stop", "description": "Stopped state" },
      "U": { "modifier": "Multifunction", "description": "Multiple modifier functions" },
      "X": { "modifier": "Unclassified", "description": "Unclassified modifier" }
    }
  },

